<mxfile host="app.diagrams.net"><diagram name="Diagrama de clases - Viajes Aventura"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1490" pageHeight="1080"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="usu" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«abstract»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Usuario&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ id: int&lt;br&gt;+ nombre: str&lt;br&gt;+ correo: str&lt;br&gt;- _hash_clave: bytes&lt;br&gt;- _sal: bytes&lt;br&gt;- _intentos_fallidos: int&lt;br&gt;+ MAX_INTENTOS: int = 3&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ __init__(nombre, correo, clave=None, *, id,&lt;br&gt;           hash_clave, sal, intentos)&lt;br&gt;+ verificar_clave(clave: str): bool&lt;br&gt;+ registrar_intento_fallido(): None&lt;br&gt;+ reiniciar_intentos(): None&lt;br&gt;+ esta_bloqueado(): bool&lt;br&gt;+ es_admin(): bool {abstract}&lt;br&gt;+ generar_hash(clave, sal): bytes {static}&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=DejaVu Sans Mono;" vertex="1" parent="1"><mxGeometry x="230" y="40" width="354" height="348" as="geometry"/></mxCell><mxCell id="cli" value="&lt;p style=&quot;margin:0;margin-top:6px;text-align:center;&quot;&gt;&lt;b&gt;Cliente&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;- _rut: str&lt;br&gt;- _telefono: str&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0;margin-left:6px;&quot;&gt;+ __init__(nombre, rut, correo, telefono,&lt;br&gt;           clave=None, **guardado)&lt;br&gt;+ rut_enmascarado(): str&lt;br&gt;+ telefono_enmascarado(): str&lt;br&gt;+ es_admin(): bool&lt;br&gt;+ validar_rut(rut: str): bool {static}&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;fontSize=12;fillColor=#dae8fc;